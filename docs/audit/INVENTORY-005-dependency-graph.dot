        libusb_core [label="core.c", fillcolor="#DDA0DD"];
        libusb_desc [label="descriptor.c", fillcolor="#DDA0DD"];
        libusb_io [label="io.c", fillcolor="#DDA0DD"];
        libusb_sync [label="sync.c", fillcolor="#DDA0DD"];
        libusb_usbfs [label="android_usbfs.c", fillcolor="#DDA0DD"];
        libusb_netlink [label="android_netlink.c", fillcolor="#DDA0DD"];

        // Headers
        libusb_h [label="libusb.h", fillcolor="#E6E6FA"];
        libusbi_h [label="libusbi.h", fillcolor="#E6E6FA"];
    }

    // =====================
    // Subgraph: libjpeg-turbo
    // =====================
    subgraph cluster_libjpeg {
        label="libjpeg-turbo1500";
        style=filled;
        color=lightyellow;

        // Key source files (subset)
        jpeg_compress [label="jcapimin.c\n(compress)", fillcolor="#FFFFE0"];
        jpeg_decompress [label="jdapimin.c\n(decompress)", fillcolor="#FFFFE0"];
