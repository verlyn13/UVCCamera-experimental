        turbojpeg_h [label="turbojpeg.h", fillcolor="#FFFACD"];
    }

    // =====================
    // System/Platform
    // =====================
    subgraph cluster_system {
        label="System Libraries";
        style=filled;
        color=lightgray;

        jni_h [label="jni.h", fillcolor="#D3D3D3"];
        android_log [label="android/log.h", fillcolor="#D3D3D3"];
        android_hwbuf [label="android/hardware_buffer.h", fillcolor="#D3D3D3"];
        android_nwin [label="android/native_window.h", fillcolor="#D3D3D3"];
        pthread_h [label="pthread.h", fillcolor="#D3D3D3"];
        stdlib_h [label="stdlib.h", fillcolor="#D3D3D3"];
    }

    // =====================
    // Dependencies: UVCCamera
    // =====================
    // Source to header (internal)
    uvc_camera -> uvc_camera_h;
    uvc_camera -> uvc_preview_h;
    uvc_camera -> uvc_handle_h;
    uvc_camera -> uvc_output_h;
    uvc_preview -> uvc_preview_h;
    uvc_preview -> uvc_ring_h;
    uvc_preview -> uvc_telem_h;
    uvc_handle -> uvc_handle_h;
    uvc_ring -> uvc_ring_h;
    uvc_ring -> uvc_telem_h;
    uvc_onload -> uvc_lib_h;

    // UVCCamera to external
    uvc_camera -> libuvc_h [color=blue, label="UVC API"];
    uvc_preview -> libuvc_h [color=blue];
    uvc_ring -> turbojpeg_h [color=orange, label="JPEG encode"];
    uvc_ring -> android_hwbuf [color=gray, label="AHardwareBuffer"];
    uvc_onload -> jni_h [color=gray];

    // =====================
    // Dependencies: libuvc
    // =====================
    libuvc_ctrl -> libuvc_int_h;
    libuvc_device -> libuvc_int_h;
    libuvc_frame -> libuvc_int_h;
    libuvc_mjpeg -> libuvc_int_h;
    libuvc_mjpeg -> jpeglib_h [color=orange, label="MJPEG decode"];
    libuvc_init -> libuvc_int_h;
    libuvc_stream -> libuvc_int_h;

    libuvc_int_h -> libuvc_h;
    libuvc_int_h -> libusb_h [color=purple, label="USB transport"];

    // =====================
    // Dependencies: libusb
    // =====================
    libusb_core -> libusbi_h;
    libusb_desc -> libusbi_h;
    libusb_io -> libusbi_h;
    libusb_sync -> libusbi_h;
    libusb_usbfs -> libusbi_h;
    libusb_netlink -> libusbi_h;

    libusbi_h -> libusb_h;
    libusbi_h -> pthread_h [color=gray];

    // =====================
    // Dependencies: libjpeg
    // =====================
    jpeg_turbo -> jpeglib_h;
    jpeg_compress -> jpeglib_h;
    jpeg_decompress -> jpeglib_h;
    jpeg_simd -> jpeglib_h;
    turbojpeg_h -> jpeglib_h;

    // =====================
    // Cross-component summary edges
    // =====================
    // Invisible edges for layout
    {rank=same; uvc_camera; uvc_preview; uvc_ring}
    {rank=same; libuvc_stream; libuvc_mjpeg}
    {rank=same; libusb_core; libusb_io}
    {rank=same; jpeg_compress; jpeg_decompress}
}
