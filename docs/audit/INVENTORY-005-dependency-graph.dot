    subgraph cluster_libuvc {
        label="libuvc.so";
        style=filled;
        color=lightblue;

        // Source files
        libuvc_ctrl [label="ctrl.c", fillcolor="#ADD8E6"];
        libuvc_device [label="device.c", fillcolor="#ADD8E6"];
        libuvc_frame [label="frame.c", fillcolor="#ADD8E6"];
        libuvc_mjpeg [label="frame-mjpeg.c", fillcolor="#ADD8E6"];
        libuvc_init [label="init.c", fillcolor="#ADD8E6"];
        libuvc_stream [label="stream.c", fillcolor="#ADD8E6"];

        // Headers
        libuvc_h [label="libuvc.h", fillcolor="#87CEEB"];
        libuvc_int_h [label="libuvc_internal.h", fillcolor="#87CEEB"];
    }

    // =====================
