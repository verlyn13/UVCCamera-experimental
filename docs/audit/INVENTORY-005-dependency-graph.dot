// Generated: 2026-01-11
// Render with: dot -Tpng INVENTORY-005-dependency-graph.dot -o dependency-graph.png

digraph UVCCamera_Dependencies {
    // Graph settings
    rankdir=TB;
    compound=true;
    node [shape=box, style=filled, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    // Color scheme
    // Green: UVCCamera core
    // Blue: libuvc
    // Purple: libusb
    // Orange: libjpeg-turbo
    // Gray: System/Platform
    // Yellow: Headers only

    // =====================
    // Subgraph: UVCCamera
    // =====================
    subgraph cluster_uvccamera {
        label="libUVCCamera.so";
        style=filled;
        color=lightgreen;

        // Source files
        uvc_onload [label="_onload.cpp", fillcolor="#90EE90"];
        uvc_camera [label="UVCCamera.cpp\n(2894 lines)", fillcolor="#90EE90"];
        uvc_preview [label="UVCPreview.cpp\n(3006 lines)", fillcolor="#90EE90"];
        uvc_handle [label="HandleManager.cpp", fillcolor="#90EE90"];
        uvc_ring [label="FrameBufferRing.cpp", fillcolor="#90EE90"];
        uvc_params [label="Parameters.cpp", fillcolor="#90EE90"];
        uvc_layout [label="LayoutContract.cpp", fillcolor="#90EE90"];
        uvc_jni [label="serenegiant_usb_UVCCamera.cpp", fillcolor="#90EE90"];

        // Headers
        uvc_camera_h [label="UVCCamera.h", fillcolor="#98FB98"];
        uvc_preview_h [label="UVCPreview.h", fillcolor="#98FB98"];
        uvc_handle_h [label="HandleManager.h", fillcolor="#98FB98"];
        uvc_ring_h [label="FrameBufferRing.h", fillcolor="#98FB98"];
        uvc_output_h [label="OutputMode.h", fillcolor="#98FB98"];
        uvc_telem_h [label="StreamTelemetry.h", fillcolor="#98FB98"];
        uvc_util_h [label="utilbase.h", fillcolor="#98FB98"];
        uvc_lib_h [label="libUVCCamera.h", fillcolor="#98FB98"];
    }

    // =====================
    // Subgraph: libuvc
