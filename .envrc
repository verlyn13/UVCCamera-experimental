# UVCCamera-experimental environment configuration
# Uses mise for tool version management

# Load mise integration (zero external calls pattern)
use_mise() {
  direnv_load mise direnv exec
}
use mise

# Add local tool directories to PATH
PATH_add tools
PATH_add node_modules/.bin

# Android SDK paths
export ANDROID_HOME="$HOME/Library/Android/sdk"
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/27.0.12077973"
PATH_add "$ANDROID_HOME/platform-tools"
PATH_add "$ANDROID_HOME/cmdline-tools/latest/bin"

# Safe environment file loading
dotenv_if_exists .env.local
dotenv_if_exists .env
